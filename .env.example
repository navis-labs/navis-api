# Copy to .env and fill in real values. NEVER commit the real .env.
APP_NAME=Navis AI Backend
APP_VERSION=2.0.0
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string

API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ==================== DATABASE (PostgreSQL) ====================
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ==================== REDIS ====================
REDIS_URL=redis://localhost:6379/0

# ==================== SECURITY & JWT ====================
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ==================== AI / ML ====================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ==================== OAUTH PROVIDERS ====================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_GMAIL_REDIRECT_URI=

# ==================== SLACK ====================
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# ==================== BACKGROUND TASKS ====================
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# ==================== FEATURE FLAGS ====================
ENABLE_GOOGLE_AUTH=True
ENABLE_AI_CACHING=True

# ==================== DEVELOPMENT ====================
RELOAD=True
SHOW_DOCS=True
LOG_LEVEL=DEBUG

# ==================== ENVIRONMENT ====================
# One of: development | staging | production  (validated — an unknown value is a
# STARTUP ERROR, not a silent downgrade).
#
# `production` enables, and every other value RELAXES:
#   * production config safety checks (SECRET_KEY strength, DEBUG, /docs exposure)
#   * field-encryption fail-fast          (PII unencrypted if keys are unset)
#   * OAuth-token-encryption fail-fast    (tokens plaintext if keys are unset)
#   * organization entitlement enforcement + the API capability guard
#   * plan defaults (non-prod hands new orgs ENTERPRISE)
#
# Set it EXPLICITLY on every deployment. An unset value defaults to development,
# which the API logs as a warning at startup naming each relaxed control.
ENVIRONMENT=development
