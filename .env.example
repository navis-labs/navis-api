# Copy to .env and fill in real values. NEVER commit the real .env.
APP_NAME=Navis AI Backend
APP_VERSION=2.0.0
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string

API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ==================== DATABASE (PostgreSQL) ====================
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ==================== REDIS ====================
REDIS_URL=redis://localhost:6379/0

# ==================== SECURITY & JWT ====================
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ==================== FIELD ENCRYPTION (at-rest) ====================
# REQUIRED in production. Encrypts Integration OAuth tokens (Gmail, Slack, Calendar)
# and SSO connection secrets at rest in the database.
#
# Generate a key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# For key rotation, comma-separate (newest first):
#   FIELD_ENCRYPTION_KEYS=NEW_KEY,OLD_KEY
FIELD_ENCRYPTION_KEYS=generate-a-real-key-see-comment-above

# ==================== AI / ML ====================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ==================== OAUTH PROVIDERS ====================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_GMAIL_REDIRECT_URI=

# ==================== SLACK ====================
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# ==================== BACKGROUND TASKS ====================
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# ==================== FEATURE FLAGS ====================
ENABLE_GOOGLE_AUTH=True
ENABLE_AI_CACHING=True

# ==================== DEVELOPMENT ====================
RELOAD=True
SHOW_DOCS=True
LOG_LEVEL=DEBUG
