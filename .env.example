# Copy to .env and fill in real values. NEVER commit the real .env.
APP_NAME=Navis AI Backend
APP_VERSION=2.0.0
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string

API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ==================== DATABASE (PostgreSQL) ====================
# RUNTIME connection — the only one the application opens.
# Against Neon, use the POOLED endpoint (the host containing "-pooler").
# Web traffic is many short transactions and belongs behind the pooler.
DATABASE_URL=postgresql://user:password@host-pooler/dbname?sslmode=require

# MIGRATION-ONLY connection. Optional; Alembic falls back to DATABASE_URL.
#
# The SAME database, reached through the DIRECT endpoint — the same host
# with "-pooler" removed. It is never a second database.
#
# Why: a migration is one long session issuing DDL, and PgBouncer's
# transaction pooling does not guarantee that session state or advisory
# locks stay on one backend. `CREATE INDEX CONCURRENTLY` cannot run in a
# transaction at all. Neon documents the direct endpoint for migrations.
#
# Leave it unset and migrations still run — Alembic says on stderr that it
# fell back, and warns if the fallback is a pooled endpoint.
# DIRECT_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ==================== REDIS ====================
REDIS_URL=redis://localhost:6380/0

# ==================== SECURITY & JWT ====================
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ==================== AI / ML ====================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ==================== OAUTH PROVIDERS ====================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_GMAIL_REDIRECT_URI=

# ==================== SLACK ====================
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# ==================== BACKGROUND TASKS ====================
CELERY_BROKER_URL=redis://localhost:6380/2
CELERY_RESULT_BACKEND=redis://localhost:6380/3

# ==================== FEATURE FLAGS ====================
ENABLE_GOOGLE_AUTH=True
ENABLE_AI_CACHING=True

# ==================== DEVELOPMENT ====================
RELOAD=True
SHOW_DOCS=True
LOG_LEVEL=DEBUG

# ==================== ENVIRONMENT ====================
# One of: development | staging | production  (validated — an unknown value is a
# STARTUP ERROR, not a silent downgrade).
#
# `production` enables, and every other value RELAXES:
#   * production config safety checks (SECRET_KEY strength, DEBUG, /docs exposure)
#   * field-encryption fail-fast          (PII unencrypted if keys are unset)
#   * OAuth-token-encryption fail-fast    (tokens plaintext if keys are unset)
#   * organization entitlement enforcement + the API capability guard
#   * plan defaults (non-prod hands new orgs ENTERPRISE)
#
# Set it EXPLICITLY on every deployment. An unset value defaults to development,
# which the API logs as a warning at startup naming each relaxed control.
ENVIRONMENT=development

# ==================== INTEGRATION TOKEN ENCRYPTION ====================
# Fernet keys for encrypting OAuth tokens at rest (comma-separated, NEWEST FIRST).
# Mandatory in production — TokenCipher.from_env refuses to start without them.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SIGNALS_TOKEN_KEYS=

# SIGNAL-CRYPTO-002 sunset switch. When false, an UNTAGGED token value is accepted
# as legacy plaintext and returned as-is — which is how encryption-at-rest can
# regress silently (TASK 6.4.1 found 4 of 6 production refresh tokens in plaintext
# that way). Turn it on once every stored token is `enc:1:` tagged; after that an
# untagged value raises TokenDecryptError instead of being trusted.
#
# Enable ONLY when the migration has been run and verified for that environment:
#   celery -A navis.platform.queue.celery_app:celery_app call \
#       navis.signals.token_backfill.reencrypt_legacy_tokens
# then confirm zero plaintext before flipping this to true.
#
# PRODUCTION REQUIRES `true` — ENVIRONMENT=production refuses to start without it
# (settings._enforce_production_safety), so this template no longer has to carry
# the setting for production's sake.
#
# The template default is `false` on purpose: with SIGNALS_TOKEN_KEYS empty (as
# above) `encrypt()` is a passthrough, so a fresh checkout would write untagged
# tokens and then reject its own writes on the next read — every local
# integration broken by copying the example file.
SIGNALS_REJECT_LEGACY_PLAINTEXT=false

# ==================== EXECUTION WORKER ISOLATION ====================
# When true, POST /actions/{id}/approve ALSO runs an execution pass inline
# (asyncio.create_task) so approved actions really execute without a Celery worker
# running — which is what makes a local demo work end to end.
#
# PRODUCTION REQUIRES `false` — ENVIRONMENT=production refuses to start with it on
# (settings._enforce_production_safety). Inline execution runs provider calls on
# the API event loop and bypasses the worker's operational envelope: the
# per-provider rate limiter, the retry budget, dead-lettering and stale-execution
# recovery all live on the Celery path. Run `celery -A navis.platform.queue worker`
# and leave this off.
#
# The template default is `true` for the same reason as the switch above: a fresh
# checkout should work without provisioning a broker.
EXECUTION_INLINE_FALLBACK=true

# ==================== GMAIL PUSH (authenticated Cloud Pub/Sub) ====================
# ALL FOUR are required together, or none. Setting GOOGLE_PUBSUB_TOPIC without the
# other three is a STARTUP ERROR in production: it makes Google POST to a public
# endpoint that could not then pin who sent the push.
#
# Leaving all of them unset is a supported state — /webhooks/google/pubsub answers
# 503 and Gmail ingestion runs on the 5-minute `sync-signals` poll instead. Push is
# a latency optimisation, not a correctness requirement.
#
# Provisioning (Google Cloud):
#   1. Create the topic and grant Gmail permission to publish to it:
#        gcloud pubsub topics create <topic>
#        gcloud pubsub topics add-iam-policy-binding <topic> \
#          --member=serviceAccount:gmail-api-push@system.gserviceaccount.com \
#          --role=roles/pubsub.publisher
#   2. Create a dedicated PUSH service account (do not reuse another workload's).
#   3. Create the push subscription with OIDC auth. `--push-auth-token-audience` is
#      the value that must equal GOOGLE_PUBSUB_AUDIENCE below:
#        gcloud pubsub subscriptions create <sub> --topic=<topic> \
#          --push-endpoint=https://<host>/api/v1/webhooks/google/pubsub \
#          --push-auth-service-account=<sa>@<project>.iam.gserviceaccount.com \
#          --push-auth-token-audience=https://<host>/api/v1/webhooks/google/pubsub
#   4. Read back the service account's numeric OIDC subject for GOOGLE_PUBSUB_SUB:
#        gcloud iam service-accounts describe <sa>@<project>.iam.gserviceaccount.com \
#          --format='value(uniqueId)'
#
# projects/<project>/topics/<topic> — registered by GmailConnector.create_watch.
GOOGLE_PUBSUB_TOPIC=
# MUST equal --push-auth-token-audience exactly (string compare, not a URL parse).
GOOGLE_PUBSUB_AUDIENCE=
# The push service account. Pin at least one of the two; both is better.
#   SA_EMAIL is human-readable but reassignable; SUB is Google's stable numeric id.
GOOGLE_PUBSUB_SA_EMAIL=
GOOGLE_PUBSUB_SUB=
